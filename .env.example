APP_NAME="Sistem Pelayanan Desa Rawa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://sistem-desa-rawa.test

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_desa_rawa
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=public

MAIL_MAILER=log

# ================================
# Fonnte WhatsApp Gateway
# Daftar & ambil token di https://fonnte.com
# ================================
FONNTE_TOKEN=isi-token-fonnte-kamu-disini
FONNTE_API_URL=https://api.fonnte.com/send
FONNTE_ENABLED=true

# ================================
# Identitas Desa (dipakai di kop surat & layout)
# ================================
DESA_NAMA="Desa Rawa"
DESA_KECAMATAN="Lumbung"
DESA_KABUPATEN="Ciamis"
DESA_PROVINSI="Jawa Barat"
DESA_ALAMAT_KANTOR="Jl. Raya Desa Rawa No. 1, Kec. Lumbung, Kab. Ciamis"
DESA_KEPALA_DESA="Nama Kepala Desa"
# Opsional: tautan embed Google Maps kantor desa (Google Maps > Bagikan > Sematkan peta > salin src iframe).
# Jika dikosongkan, homepage otomatis membuat tautan pencarian dari DESA_ALAMAT_KANTOR di atas.
DESA_MAPS_EMBED_URL=
